{
  "log_dir": "logs",
  "log_level": "INFO",
  "console_output": true,
  "log_format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
  "date_format": "%Y-%m-%d %H:%M:%S",
  "file_rotation": {
    "enabled": false,
    "max_size_mb": 10,
    "backup_count": 5
  },
  "description": "日志系统配置文件。可以在main.py中通过Logger.setup()使用这些配置。"
}
